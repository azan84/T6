\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Reclassification rate (proportion of models whose classification at FFR 0.80 changed) by baseline FFR band, error type, protocol (A--C; D in Table~\ref {tab:results}) and bed structure; T5 pools both signs of the half-voxel throat error. Bands are 0.05 wide and plotted at their center; bands with fewer than three models are omitted. The shaded area is the reclassification rate expected from repeat invasive FFR alone (standard deviation 0.018).}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:band}{{2}{6}{Reclassification rate (proportion of models whose classification at FFR 0.80 changed) by baseline FFR band, error type, protocol (A--C; D in Table~\ref {tab:results}) and bed structure; T5 pools both signs of the half-voxel throat error. Bands are 0.05 wide and plotted at their center; bands with fewer than three models are omitted. The shaded area is the reclassification rate expected from repeat invasive FFR alone (standard deviation 0.018)}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {III-C}Overlap Scores and the Pre-Tuning Mismatch}{6}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Change in FFR against territory-perfusion residual for missed-branch and vessel-break models under Protocols A--C (Protocol D residuals lie below 0.01 in all but two models). Each point is one model. The shaded areas hold models that pass the perfusion check (residual $< 0.10$) while materially wrong ($|\Delta \mathrm  {FFR}| > 0.05$); the dashed line marks the 0.10 threshold. The horizontal axis is linear below 0.01 and logarithmic above.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:absorb}{{3}{6}{Change in FFR against territory-perfusion residual for missed-branch and vessel-break models under Protocols A--C (Protocol D residuals lie below 0.01 in all but two models). Each point is one model. The shaded areas hold models that pass the perfusion check (residual $< 0.10$) while materially wrong ($|\Delta \mathrm {FFR}| > 0.05$); the dashed line marks the 0.10 threshold. The horizontal axis is linear below 0.01 and logarithmic above}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Tube-model Dice score of each corrupted tree, over the whole scan, against its change in FFR with fixed boundary conditions (Protocol A). Each point is one model. The dashed line marks the inter-observer Dice score (0.928); the shaded band holds changes within $\pm 0.05$. T5 pools both signs of the half-voxel throat error.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:overlap}{{4}{6}{Tube-model Dice score of each corrupted tree, over the whole scan, against its change in FFR with fixed boundary conditions (Protocol A). Each point is one model. The dashed line marks the inter-observer Dice score (0.928); the shaded band holds changes within $\pm 0.05$. T5 pools both signs of the half-voxel throat error}{figure.4}{}}
