transportModel  Newtonian;

// nu = mu/rho = 0.004/1060, unrounded. The commonly-quoted 3.774e-6 is a +0.011% rounding
// (audit finding, cosmetic in effect but use the exact quotient in executable input).
nu              nu [0 2 -1 0 0 0 0] 3.773585e-06;
