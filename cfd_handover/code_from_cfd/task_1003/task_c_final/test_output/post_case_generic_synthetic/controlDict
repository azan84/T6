        {
            type plane; planeType pointAndNormal;
            pointAndNormalDict { point (6.000000000e-03 0.000000000e+00 0.000000000e+00); normal (1.000000000e+00 0.000000000e+00 0.000000000e+00); }
            bounds (4.000000000e-03 -2.000000000e-03 -2.000000000e-03) (8.000000000e-03 2.000000000e-03 2.000000000e-03);
            interpolate false;
